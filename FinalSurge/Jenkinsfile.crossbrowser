def testFilter(String category) {
    return params.SUITE == 'Smoke' ? "Category=${category}&Category=Smoke" : "Category=${category}"
}

def runTests(String project, String category) {
    withCredentials([usernamePassword(credentialsId: 'final-surge',
            usernameVariable: 'TestSettings__Email', passwordVariable: 'TestSettings__Password')]) {
        dir('FinalSurge') {
            sh "dotnet test ${project} --no-build --filter \"${testFilter(category)}\""
        }
    }
}

def notifyTelegram(String browser) {
    def stats = sh(returnStdout: true, script: '''
        jq -r '.statistic | "Passed \\(.passed) of \\(.total), failed \\(.failed), broken \\(.broken)"' allure-report/widgets/summary.json || echo "No test results"
    ''').trim()
    def icon = currentBuild.currentResult == 'SUCCESS' ? '✅' : '❌'
    def text = "${icon} ${env.JOB_NAME} #${env.BUILD_NUMBER}: ${currentBuild.currentResult}\n" +
            "Suite: ${params.SUITE}, browser: ${browser}\n" +
            "${stats}\n" +
            "Allure: ${env.BUILD_URL}allure/"
    withEnv(["TELEGRAM_TEXT=${text}"]) {
        withCredentials([string(credentialsId: 'telegram-bot-token', variable: 'TELEGRAM_TOKEN'),
                         string(credentialsId: 'telegram-chat-id', variable: 'TELEGRAM_CHAT_ID')]) {
            sh 'curl -sS --fail-with-body -X POST "https://api.telegram.org/bot$TELEGRAM_TOKEN/sendMessage" -d chat_id="$TELEGRAM_CHAT_ID" --data-urlencode text="$TELEGRAM_TEXT"'
        }
    }
}

pipeline {
    agent any

    environment {
        TestSettings__GridUrl = 'http://selenium-hub:4444'
        TestSettings__Headless = 'true'
        MSBUILDDISABLENODEREUSE = '1'
        UseSharedCompilation = 'false'
        TESTS_RESULTS = 'FinalSurge/FinalSurge.Tests/bin/Debug/net10.0/allure-results'
        BDD_RESULTS = 'FinalSurge/FinalSurge.Bdd/bin/Debug/net10.0/allure-results'
    }

    stages {
        stage('Restore') {
            steps {
                dir('FinalSurge') {
                    sh 'dotnet restore'
                }
            }
        }

        stage('Build') {
            steps {
                sh "rm -rf ${TESTS_RESULTS} ${BDD_RESULTS}"
                dir('FinalSurge') {
                    sh 'dotnet build --no-restore'
                }
            }
        }

        stage('Cross-browser') {
            matrix {
                axes {
                    axis {
                        name 'BROWSER'
                        values 'Chrome', 'Firefox'
                    }
                }

                environment {
                    TestSettings__Browser = "${BROWSER}"
                }

                stages {
                    stage('UI') {
                        steps {
                            runTests('FinalSurge.Tests', 'UI')
                        }
                    }

                    stage('BDD') {
                        steps {
                            runTests('FinalSurge.Bdd', 'UI')
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            allure commandline: 'allure Jenkins', results: [[path: "${TESTS_RESULTS}"], [path: "${BDD_RESULTS}"]]
            notifyTelegram('Chrome, Firefox')
        }
    }
}
